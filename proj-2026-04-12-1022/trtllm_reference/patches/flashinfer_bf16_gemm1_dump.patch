+template <class CoordTensorA, class CoordTensorB, class F>
+CUTE_HOST_DEVICE void ForEachProbeCoordPair(CoordTensorA const& coords_a, CoordTensorB const& coords_b, F&& f) {
+  static_assert(
+      std::remove_cv_t<std::remove_reference_t<CoordTensorA>>::rank ==
+          std::remove_cv_t<std::remove_reference_t<CoordTensorB>>::rank,
+      "coord tensor rank mismatch");
+  if constexpr (std::remove_cv_t<std::remove_reference_t<CoordTensorA>>::rank == 1) {
+    for (int i = 0; i < size<0>(coords_a); ++i) {
+      auto const idx = make_coord(i);
+      f(coords_a(idx), coords_b(idx), i);
+    }
+  } else if constexpr (std::remove_cv_t<std::remove_reference_t<CoordTensorA>>::rank == 2) {
+    int physical = 0;
+    for (int i = 0; i < size<0>(coords_a); ++i) {
+      for (int j = 0; j < size<1>(coords_a); ++j) {
+        auto const idx = make_coord(i, j);
+        f(coords_a(idx), coords_b(idx), physical++);
+      }
+    }
+  } else if constexpr (std::remove_cv_t<std::remove_reference_t<CoordTensorA>>::rank == 3) {
+    int physical = 0;
+    for (int i = 0; i < size<0>(coords_a); ++i) {
+      for (int j = 0; j < size<1>(coords_a); ++j) {
+        for (int k = 0; k < size<2>(coords_a); ++k) {
+          auto const idx = make_coord(i, j, k);
+          f(coords_a(idx), coords_b(idx), physical++);
+        }
+      }
+    }
+  } else if constexpr (std::remove_cv_t<std::remove_reference_t<CoordTensorA>>::rank == 4) {
+    int physical = 0;
+    for (int i = 0; i < size<0>(coords_a); ++i) {
+      for (int j = 0; j < size<1>(coords_a); ++j) {
+        for (int k = 0; k < size<2>(coords_a); ++k) {
+          for (int l = 0; l < size<3>(coords_a); ++l) {
+            auto const idx = make_coord(i, j, k, l);
+            f(coords_a(idx), coords_b(idx), physical++);
+          }
+        }
+      }
+    }
+  } else {
+    static_assert(
+        std::remove_cv_t<std::remove_reference_t<CoordTensorA>>::rank <= 4,
+        "ForEachProbeCoordPair only supports rank <= 4");
+  }
+}
