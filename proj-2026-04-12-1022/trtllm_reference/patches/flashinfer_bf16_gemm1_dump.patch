+inline void resetNemotronBOperandProbe(void* probe_workspace, size_t probe_workspace_size,
+                                       bool enable_probe, bool swap_ab) {
+  if (probe_workspace == nullptr ||
+      probe_workspace_size < cutlass::gemm::collective::nemotron_probe::ProbeStorageBytes()) {
+    return;
+  }
+  NemotronBOperandProbeState probe = {};
+  char const* any_thread = std::getenv("NEMOTRON_TRTLLM_OPERAND_PROBE_ANY_THREAD");
+  char const* overwrite_all_threads =
+      std::getenv("NEMOTRON_TRTLLM_OPERAND_PROBE_OVERWRITE_ALL_THREADS");
+  char const* stage_slot_low_byte =
+      std::getenv("NEMOTRON_TRTLLM_OPERAND_PROBE_STAGE_SLOT_LOW_BYTE");
+  char const* stage_slot_bit =
+      std::getenv("NEMOTRON_TRTLLM_OPERAND_PROBE_STAGE_SLOT_BIT");
+  probe.enabled = enable_probe ? 1 : 0;
+  probe.entry_count = cutlass::gemm::collective::nemotron_probe::kEntryCount;
+  probe.max_n_tiles = cutlass::gemm::collective::nemotron_probe::kMaxNTiles;
+  probe.max_k_blocks = cutlass::gemm::collective::nemotron_probe::kMaxKBlocks;
+  probe.dispatch_stages = -1;
+  probe.dispatch_scheduler_stages = -1;
+  probe.epilogue_shared_storage_bytes = -1;
+  probe.mainloop_shared_storage_bytes = -1;
+  probe.next_slot = 0;
+  probe.capture_any_thread =
+      (any_thread != nullptr && any_thread[0] != '\0' && any_thread[0] != '0') ? 1 : 0;
+  probe.overwrite_all_threads =
+      (overwrite_all_threads != nullptr &&
+       overwrite_all_threads[0] != '\0' &&
+       overwrite_all_threads[0] != '0') ? 1 : 0;
+  probe.filter_block_idx_x =
+      loadNemotronEnvIntOrDefault("NEMOTRON_TRTLLM_OPERAND_PROBE_BLOCK_X", -1);
+  probe.filter_block_idx_y =
+      loadNemotronEnvIntOrDefault("NEMOTRON_TRTLLM_OPERAND_PROBE_BLOCK_Y", -1);
+  probe.filter_block_idx_z =
+      loadNemotronEnvIntOrDefault("NEMOTRON_TRTLLM_OPERAND_PROBE_BLOCK_Z", -1);
+  loadNemotronBOperandProbeOperandKind(probe);
+  configureNemotronBOperandProbePhysicalMapping(probe, swap_ab);
+  probe.synthetic_b_mode = 0;
+  probe.synthetic_b_arg = -1;
+  if (stage_slot_bit != nullptr && stage_slot_bit[0] != '\0') {
+    probe.synthetic_b_mode =
+        int(cutlass::gemm::collective::nemotron_probe::SyntheticBMode::kStageSlotBit);
+    probe.synthetic_b_arg = std::atoi(stage_slot_bit);
+  } else if (stage_slot_low_byte != nullptr &&
+             stage_slot_low_byte[0] != '\0' &&
+             stage_slot_low_byte[0] != '0') {
+    probe.synthetic_b_mode =
+        int(cutlass::gemm::collective::nemotron_probe::SyntheticBMode::kStageSlotLowByte);
+  }
+  loadNemotronBOperandProbeTrackedTids(probe);
+  for (int stage = 0; stage < cutlass::gemm::collective::nemotron_probe::kMaxSemanticStageCount; ++stage) {
+    std::fill_n(
+        probe.semantic_weight_rows[stage],
+        cutlass::gemm::collective::nemotron_probe::kMaxSemanticStageByteSlots,
+        static_cast<std::int16_t>(-1));
+    std::fill_n(
+        probe.semantic_weight_byte_indices[stage],
+        cutlass::gemm::collective::nemotron_probe::kMaxSemanticStageByteSlots,
+        static_cast<std::int16_t>(-1));
+    std::fill_n(
+        probe.semantic_weight_k_tiles[stage],
+        cutlass::gemm::collective::nemotron_probe::kMaxSemanticStageByteSlots,
+        static_cast<std::int16_t>(-1));
+    std::fill_n(
+        probe.semantic_weight_rows_alt[stage],
+        cutlass::gemm::collective::nemotron_probe::kMaxSemanticStageByteSlots,
+        static_cast<std::int16_t>(-1));
+    std::fill_n(
+        probe.semantic_weight_byte_indices_alt[stage],
+        cutlass::gemm::collective::nemotron_probe::kMaxSemanticStageByteSlots,
+        static_cast<std::int16_t>(-1));
+    std::fill_n(
+        probe.semantic_weight_k_tiles_alt[stage],
+        cutlass::gemm::collective::nemotron_probe::kMaxSemanticStageByteSlots,
+        static_cast<std::int16_t>(-1));
+  }
+  probe.producer_debug_count = 0;
+  std::fill_n(
+      probe.producer_debug_stage,
+      cutlass::gemm::collective::nemotron_probe::kProducerDebugEntryCount,
+      -1);
+  std::fill_n(
+      probe.producer_debug_slot,
+      cutlass::gemm::collective::nemotron_probe::kProducerDebugEntryCount,
+      -1);
+  std::fill_n(
+      probe.producer_debug_value,
+      cutlass::gemm::collective::nemotron_probe::kProducerDebugEntryCount,
+      -1);
+  for (int idx = 0; idx < cutlass::gemm::collective::nemotron_probe::kProducerDebugEntryCount; ++idx) {
+    std::fill_n(
+        probe.producer_debug_src[idx],
+        cutlass::gemm::collective::nemotron_probe::kProducerDebugComponentCount,
+        -1);
+    std::fill_n(
+        probe.producer_debug_dst[idx],
+        cutlass::gemm::collective::nemotron_probe::kProducerDebugComponentCount,
+        -1);
+  }
+  cudaMemcpy(probe_workspace, &probe, sizeof(probe), cudaMemcpyHostToDevice);
+}
