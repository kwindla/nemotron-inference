+template <class Coord>
+CUTE_HOST_DEVICE constexpr int CoordGet0(Coord const& coord) {
+  int row = 0;
+  int col = 0;
+  int count = 0;
+  FlattenCoordPair(coord, row, col, count);
+  (void) col;
+  return row;
+}
