+inline void dumpNemotronBOperandProbe(char const* probe_path, void* probe_workspace,
+                                      size_t probe_workspace_size) {
+  if (probe_workspace == nullptr ||
+      probe_workspace_size < cutlass::gemm::collective::nemotron_probe::ProbeStorageBytes()) {
+    std::fprintf(stderr, "[NEMOTRON] probe workspace too small for operand probe\n");
+    return;
+  }
+  NemotronBOperandProbeState probe = {};
+  cudaError_t const probe_err =
+      cudaMemcpy(&probe, probe_workspace, sizeof(probe), cudaMemcpyDeviceToHost);
+  if (probe_err != cudaSuccess) {
+    std::fprintf(stderr,
+                 "[NEMOTRON] failed to copy B operand probe: %s\n",
+                 cudaGetErrorString(probe_err));
+    return;
+  }
+
+  FILE* probe_fp = std::fopen(probe_path, "w");
+  if (probe_fp == nullptr) {
+    std::fprintf(stderr, "[NEMOTRON] failed to open operand probe path %s\n", probe_path);
+    return;
+  }
+
+  char const* operand_label =
+      probe.operand_kind ==
+              int(cutlass::gemm::collective::nemotron_probe::OperandKind::kActivation)
+          ? "activation"
+          : "weight";
+  char const* physical_a_operand_label =
+      probe.physical_a_operand_kind ==
+              int(cutlass::gemm::collective::nemotron_probe::OperandKind::kActivation)
+          ? "activation"
+          : "weight";
+  char const* physical_b_operand_label =
+      probe.physical_b_operand_kind ==
+              int(cutlass::gemm::collective::nemotron_probe::OperandKind::kActivation)
+          ? "activation"
+          : "weight";
+
+  std::fprintf(
+      probe_fp,
+      "NEMOTRON_B_OPERAND_PROBE version=7 enabled=%d entry_count=%d max_n_tiles=%d max_k_blocks=%d dispatch=(%d,%d) shared_storage_bytes=(%d,%d) next_slot=%d capture_any_thread=%d overwrite_all_threads=%d block_filter=(%d,%d,%d) operand_kind=%d operand=%s swap_ab=%d physical_a_operand_kind=%d physical_a_operand=%s physical_b_operand_kind=%d physical_b_operand=%s synthetic_b_mode=%d synthetic_b_arg=%d tracked_tid_count=%d tracked_tids=",
+      probe.enabled,
+      probe.entry_count,
+      probe.max_n_tiles,
+      probe.max_k_blocks,
+      probe.dispatch_stages,
+      probe.dispatch_scheduler_stages,
+      probe.epilogue_shared_storage_bytes,
+      probe.mainloop_shared_storage_bytes,
+      probe.next_slot,
+      probe.capture_any_thread,
+      probe.overwrite_all_threads,
+      probe.filter_block_idx_x,
+      probe.filter_block_idx_y,
+      probe.filter_block_idx_z,
+      probe.operand_kind,
+      operand_label,
+      probe.swap_ab,
+      probe.physical_a_operand_kind,
+      physical_a_operand_label,
+      probe.physical_b_operand_kind,
+      physical_b_operand_label,
+      probe.synthetic_b_mode,
+      probe.synthetic_b_arg,
+      probe.tracked_tid_count);
+  int const safe_tracked_tid_count =
+      std::max(0, std::min(probe.tracked_tid_count,
+                           cutlass::gemm::collective::nemotron_probe::kMaxTrackedTidCount));
+  for (int idx = 0; idx < safe_tracked_tid_count; ++idx) {
+    std::fprintf(probe_fp, "%s%d", idx == 0 ? "" : ",", probe.tracked_tids[idx]);
+  }
+  std::fprintf(probe_fp, "\n");
+  int const safe_producer_debug_count =
+      std::max(0, std::min(probe.producer_debug_count,
+                           cutlass::gemm::collective::nemotron_probe::kProducerDebugEntryCount));
+  if (safe_producer_debug_count > 0) {
+    for (int idx = 0; idx < safe_producer_debug_count; ++idx) {
+      std::fprintf(
