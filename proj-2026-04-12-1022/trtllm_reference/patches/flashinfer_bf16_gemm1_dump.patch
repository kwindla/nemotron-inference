+template <class DumpElem>
+inline void dumpNemotronGemm1Boundary(
+    char const* dump_path,
+    void const* gemm_output,
+    std::size_t dump_rows,
+    std::size_t dump_cols,
+    bool is_gated_activation) {
+  std::size_t const dump_elems = dump_rows * dump_cols;
+  std::size_t const dump_bytes = dump_elems * sizeof(DumpElem);
+  std::vector<unsigned char> host_buf(dump_bytes);
+  cudaError_t const memcpy_err = cudaMemcpy(
+      host_buf.data(),
+      static_cast<DumpElem const*>(gemm_output),
+      dump_bytes,
+      cudaMemcpyDeviceToHost);
+  if (memcpy_err != cudaSuccess) {
+    std::fprintf(stderr,
+                 "[NEMOTRON] failed to copy BF16 gemm1_output: %s\n",
+                 cudaGetErrorString(memcpy_err));
+    return;
+  }
+
+  if (FILE* dump_fp = std::fopen(dump_path, "wb")) {
+    unsigned char header[64] = {};
+    header[0] = 'N'; header[1] = 'E'; header[2] = 'M';
+    header[3] = 'O'; header[4] = 'P'; header[5] = '1';
+    std::uint32_t const version = 1u;
+    std::uint32_t const rows_u32 = static_cast<std::uint32_t>(dump_rows);
+    std::uint32_t const cols_u32 = static_cast<std::uint32_t>(dump_cols);
+    std::uint32_t const elem_bytes_u32 = static_cast<std::uint32_t>(sizeof(DumpElem));
+    std::uint32_t const gated_u32 = static_cast<std::uint32_t>(is_gated_activation ? 1u : 0u);
+    std::memcpy(header + 8, &version, 4);
+    std::memcpy(header + 12, &rows_u32, 4);
+    std::memcpy(header + 16, &cols_u32, 4);
+    std::memcpy(header + 20, &elem_bytes_u32, 4);
+    std::memcpy(header + 24, &gated_u32, 4);
+    std::fwrite(header, 1, sizeof(header), dump_fp);
+    std::fwrite(host_buf.data(), 1, dump_bytes, dump_fp);
+    std::fclose(dump_fp);
+    std::fprintf(stderr,
+                 "[NEMOTRON] wrote %zu bytes of BF16 gemm1_output to %s (rows=%zu cols=%zu)\n",
+                 dump_bytes, dump_path, dump_rows, dump_cols);
+  }
+}
+
+inline void dumpNemotronRawBuffer(
+    char const* dump_path,
+    void const* device_ptr,
+    std::size_t dump_bytes,
+    char const* label) {
+  std::vector<unsigned char> host_buf(dump_bytes);
+  cudaError_t const memcpy_err =
+      cudaMemcpy(host_buf.data(), device_ptr, dump_bytes, cudaMemcpyDeviceToHost);
+  if (memcpy_err != cudaSuccess) {
+    std::fprintf(stderr,
+                 "[NEMOTRON] failed to copy %s: %s\n",
+                 label,
+                 cudaGetErrorString(memcpy_err));
+    return;
+  }
+
+  if (FILE* dump_fp = std::fopen(dump_path, "wb")) {
+    std::fwrite(host_buf.data(), 1, dump_bytes, dump_fp);
+    std::fclose(dump_fp);
+    std::fprintf(stderr,
+                 "[NEMOTRON] wrote %zu raw bytes of %s to %s\n",
+                 dump_bytes,
+                 label,
+                 dump_path);
+  }
+}
+
+enum class NemotronPackedBytePattern : int {
+  kDisabled = 0,
+  kRowIndex = 1,
+  kByteIndexLow8 = 2,
+  kLinearIndexLow8 = 3,
+  kRowXorByteLow8 = 4,
+};
+
+inline NemotronPackedBytePattern parseNemotronPackedBytePattern(char const* pattern_name) {
+  if (pattern_name == nullptr || pattern_name[0] == '\0') {
+    return NemotronPackedBytePattern::kDisabled;
+  }
+  if (std::strcmp(pattern_name, "row_index") == 0) {
+    return NemotronPackedBytePattern::kRowIndex;
+  }
+  if (std::strcmp(pattern_name, "byte_index_low8") == 0) {
+    return NemotronPackedBytePattern::kByteIndexLow8;
+  }
+  if (std::strcmp(pattern_name, "linear_index_low8") == 0) {
+    return NemotronPackedBytePattern::kLinearIndexLow8;
+  }
+  if (std::strcmp(pattern_name, "row_xor_byte_low8") == 0) {
+    return NemotronPackedBytePattern::kRowXorByteLow8;
+  }
+  return NemotronPackedBytePattern::kDisabled;
+}
+
+__global__ void nemotronFillPackedBytePatternKernel(
+    std::uint8_t* out,
+    std::size_t row_bytes,
+    int rows,
+    NemotronPackedBytePattern pattern) {
+  std::size_t const total = static_cast<std::size_t>(rows) * row_bytes;
+  std::size_t idx = static_cast<std::size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  while (idx < total) {
+    std::size_t const row = idx / row_bytes;
+    std::size_t const col = idx % row_bytes;
+    std::uint8_t value = 0u;
+    switch (pattern) {
+      case NemotronPackedBytePattern::kRowIndex:
+        value = static_cast<std::uint8_t>(row & 0xffu);
+        break;
+      case NemotronPackedBytePattern::kByteIndexLow8:
+        value = static_cast<std::uint8_t>(col & 0xffu);
+        break;
+      case NemotronPackedBytePattern::kLinearIndexLow8:
+        value = static_cast<std::uint8_t>(idx & 0xffu);
+        break;
+      case NemotronPackedBytePattern::kRowXorByteLow8:
+        value = static_cast<std::uint8_t>((row ^ col) & 0xffu);
+        break;
+      default:
+        value = 0u;
+        break;
+    }
+    out[idx] = value;
+    idx += static_cast<std::size_t>(blockDim.x) * gridDim.x;
+  }
+}
+
+inline void maybeOverwriteNemotronGemm1Input(
+    char const* pattern_name,
+    void* device_ptr,
+    std::size_t row_bytes,
+    int rows,
+    cudaStream_t stream) {
+  NemotronPackedBytePattern const pattern = parseNemotronPackedBytePattern(pattern_name);
+  if (pattern == NemotronPackedBytePattern::kDisabled) {
+    return;
+  }
+  std::size_t const total = static_cast<std::size_t>(rows) * row_bytes;
+  int const threads = 256;
+  int const blocks = static_cast<int>((total + threads - 1) / threads);
+  nemotronFillPackedBytePatternKernel<<<blocks, threads, 0, stream>>>(
+      static_cast<std::uint8_t*>(device_ptr),
+      row_bytes,
+      rows,
+      pattern);
+  cudaError_t const kernel_err = cudaGetLastError();
+  if (kernel_err != cudaSuccess) {
+    std::fprintf(stderr,
+                 "[NEMOTRON] failed to launch gemm1_input overwrite pattern=%s: %s\n",
+                 pattern_name,
+                 cudaGetErrorString(kernel_err));
+  } else {
+    std::fprintf(stderr,
+                 "[NEMOTRON] overwrote gemm1_input with pattern=%s (rows=%d row_bytes=%zu)\n",
+                 pattern_name,
+                 rows,
+                 row_bytes);
+  }
+}
