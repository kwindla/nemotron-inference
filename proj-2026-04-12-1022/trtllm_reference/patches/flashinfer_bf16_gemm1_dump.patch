+CUTE_DEVICE CtaTileContextEntry const* LoadCurrentCtaTileContext(
+    BOperandProbeState const* probe_state) {
+  if (probe_state == nullptr || !ProbeCurrentBlockMatches(probe_state)) {
+    return nullptr;
+  }
+  int const slot = BlockContextSlot();
+  if (slot < 0) {
+    return nullptr;
+  }
+  CtaTileContextEntry const& entry = probe_state->cta_contexts[slot];
+  if (entry.valid == 0 ||
+      entry.block_idx_x != static_cast<int>(blockIdx.x) ||
+      entry.block_idx_y != static_cast<int>(blockIdx.y) ||
+      entry.block_idx_z != static_cast<int>(blockIdx.z)) {
+    return nullptr;
+  }
+  return &entry;
+}
