ARG CUDA_VERSION=13.0.1
ARG PYTHON_VERSION=3.12
ARG FLASHINFER_VERSION=0.6.5
ARG BUILD_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.12-py3
ARG FINAL_BASE_IMAGE=${BUILD_BASE_IMAGE}
ARG PYTORCH_CUDA_INDEX_BASE_URL=https://download.pytorch.org/whl

FROM ${BUILD_BASE_IMAGE} AS base

ARG CUDA_VERSION
ARG PYTHON_VERSION
ARG PYTORCH_CUDA_INDEX_BASE_URL

ENV PATH="/root/.local/bin:${PATH}"
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY="unsafe-best-match"
ENV UV_LINK_MODE=copy
ENV UV_BREAK_SYSTEM_PACKAGES=1
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV VLLM_ENABLE_CUDA_COMPATIBILITY=0

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && python3 --version \
    && python3 -m pip --version

WORKDIR /workspace

COPY requirements/common.txt requirements/common.txt
COPY requirements/cuda.txt requirements/cuda.txt
COPY requirements/build.txt requirements/build.txt
COPY pyproject.toml pyproject.toml
COPY use_existing_torch.py use_existing_torch.py

RUN python3 use_existing_torch.py --prefix

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages -r requirements/cuda.txt \
        --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.')

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages -r requirements/build.txt \
        --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.')

FROM base AS extensions-build

ARG CUDA_VERSION

WORKDIR /workspace

COPY tools/install_deepgemm.sh /tmp/install_deepgemm.sh
RUN --mount=type=cache,target=/root/.cache/uv \
    mkdir -p /tmp/deepgemm/dist \
    && VLLM_DOCKER_BUILD_CONTEXT=1 TORCH_CUDA_ARCH_LIST="9.0a 10.0a" /tmp/install_deepgemm.sh \
        --cuda-version "${CUDA_VERSION}" \
        --wheel-dir /tmp/deepgemm/dist \
    || echo "DeepGEMM build skipped (CUDA version requirement not met)"

RUN mkdir -p /tmp/deepgemm/dist && touch /tmp/deepgemm/dist/.deepgemm_skipped

COPY tools/ep_kernels/install_python_libraries.sh /tmp/install_python_libraries.sh
ARG DEEPEP_COMMIT_HASH=73b6ea4
ARG NVSHMEM_VER
RUN --mount=type=cache,target=/root/.cache/uv \
    mkdir -p /tmp/ep_kernels_workspace/dist \
    && export TORCH_CUDA_ARCH_LIST='9.0a 10.0a' \
    && /tmp/install_python_libraries.sh \
        --workspace /tmp/ep_kernels_workspace \
        --mode wheel \
        ${DEEPEP_COMMIT_HASH:+--deepep-ref "$DEEPEP_COMMIT_HASH"} \
        ${NVSHMEM_VER:+--nvshmem-ver "$NVSHMEM_VER"} \
    && find /tmp/ep_kernels_workspace/nvshmem -name '*.a' -delete

FROM base AS wheel-build

ARG max_jobs=8
ARG nvcc_threads=2
ARG torch_cuda_arch_list=12.1
ARG VLLM_VERSION_OVERRIDE

ENV MAX_JOBS=${max_jobs}
ENV NVCC_THREADS=${nvcc_threads}
ENV TORCH_CUDA_ARCH_LIST=${torch_cuda_arch_list}
ENV VLLM_TARGET_DEVICE=cuda
ENV VLLM_DOCKER_BUILD_CONTEXT=1
ENV CCACHE_DIR=/root/.cache/ccache

WORKDIR /workspace
COPY . .

RUN --mount=type=cache,target=/root/.cache/ccache \
    --mount=type=cache,target=/root/.cache/uv \
    export VLLM_VERSION_OVERRIDE="${VLLM_VERSION_OVERRIDE}" \
    && export SETUPTOOLS_SCM_PRETEND_VERSION="${VLLM_VERSION_OVERRIDE}" \
    && python3 use_existing_torch.py --prefix \
    && python3 setup.py bdist_wheel --dist-dir=dist --py-limited-api=cp38

FROM base AS vllm-base

ARG CUDA_VERSION
ARG FLASHINFER_VERSION
ARG TARGETPLATFORM
ARG PYTORCH_CUDA_INDEX_BASE_URL

COPY --from=wheel-build /workspace/dist /tmp/vllm-dist
COPY --from=extensions-build /tmp/deepgemm/dist /tmp/deepgemm/dist
COPY --from=extensions-build /tmp/ep_kernels_workspace/dist /tmp/ep_kernels_workspace/dist

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages /tmp/vllm-dist/*.whl --verbose --no-deps \
        --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.') \
    && uv pip install --system --break-system-packages flashinfer-cubin==${FLASHINFER_VERSION} \
    && uv pip install --system --break-system-packages flashinfer-jit-cache==${FLASHINFER_VERSION} \
        --extra-index-url https://flashinfer.ai/whl/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.') \
    && flashinfer show-config

RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
        BITSANDBYTES_VERSION="0.42.0"; \
    else \
        BITSANDBYTES_VERSION="0.46.1"; \
    fi; \
    uv pip install --system --break-system-packages accelerate hf_transfer modelscope \
        "bitsandbytes>=${BITSANDBYTES_VERSION}" "timm>=1.0.17" "runai-model-streamer[s3,gcs]>=0.15.3"

RUN --mount=type=cache,target=/root/.cache/uv \
    sh -c 'if ls /tmp/deepgemm/dist/*.whl >/dev/null 2>&1; then \
              uv pip install --system --break-system-packages /tmp/deepgemm/dist/*.whl; \
           else \
              echo "No DeepGEMM wheels to install; skipping."; \
           fi'

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages /tmp/ep_kernels_workspace/dist/*.whl --verbose \
        --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.')

ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}
ENV VLLM_USAGE_SOURCE=production-docker-image

WORKDIR /srv

FROM vllm-base AS vllm-openai

ENTRYPOINT ["vllm", "serve"]
