+CUTE_DEVICE void ClearSemanticWeightStage(BOperandProbeState* probe_state, int stage_idx) {
+  if (probe_state == nullptr ||
+      stage_idx < 0 ||
+      stage_idx >= kMaxSemanticStageCount) {
+    return;
+  }
+  for (int slot = 0; slot < kMaxSemanticStageByteSlots; ++slot) {
+    probe_state->semantic_weight_rows[stage_idx][slot] = static_cast<std::int16_t>(-1);
+    probe_state->semantic_weight_byte_indices[stage_idx][slot] = static_cast<std::int16_t>(-1);
+    probe_state->semantic_weight_k_tiles[stage_idx][slot] = static_cast<std::int16_t>(-1);
+    probe_state->semantic_weight_rows_alt[stage_idx][slot] = static_cast<std::int16_t>(-1);
+    probe_state->semantic_weight_byte_indices_alt[stage_idx][slot] = static_cast<std::int16_t>(-1);
+    probe_state->semantic_weight_k_tiles_alt[stage_idx][slot] = static_cast<std::int16_t>(-1);
+  }
+}
+
+CUTE_DEVICE void StoreSemanticWeightStageSlot(
+    BOperandProbeState* probe_state,
+    int stage_idx,
+    int stage_byte_slot,
+    int source_row,
+    int source_byte_index,
+    int source_k_tile) {
+  if (probe_state == nullptr ||
+      stage_idx < 0 ||
+      stage_idx >= kMaxSemanticStageCount ||
+      stage_byte_slot < 0 ||
+      stage_byte_slot >= kMaxSemanticStageByteSlots) {
+    return;
+  }
+  if (probe_state->semantic_weight_rows[stage_idx][stage_byte_slot] ==
+      static_cast<std::int16_t>(-1)) {
+    probe_state->semantic_weight_rows[stage_idx][stage_byte_slot] =
+        static_cast<std::int16_t>(ClampSemanticCoordComponent(source_row));
+    probe_state->semantic_weight_byte_indices[stage_idx][stage_byte_slot] =
+        static_cast<std::int16_t>(ClampSemanticCoordComponent(source_byte_index));
+    probe_state->semantic_weight_k_tiles[stage_idx][stage_byte_slot] =
+        static_cast<std::int16_t>(ClampSemanticCoordComponent(source_k_tile));
+    return;
+  }
+  if (probe_state->semantic_weight_rows_alt[stage_idx][stage_byte_slot] ==
+      static_cast<std::int16_t>(-1)) {
+    probe_state->semantic_weight_rows_alt[stage_idx][stage_byte_slot] =
+        static_cast<std::int16_t>(ClampSemanticCoordComponent(source_row));
+    probe_state->semantic_weight_byte_indices_alt[stage_idx][stage_byte_slot] =
+        static_cast<std::int16_t>(ClampSemanticCoordComponent(source_byte_index));
+    probe_state->semantic_weight_k_tiles_alt[stage_idx][stage_byte_slot] =
+        static_cast<std::int16_t>(ClampSemanticCoordComponent(source_k_tile));
+  }
+}
+
+template <class SrcCoord, class DstCoord>
+CUTE_DEVICE void RecordProducerSemanticDebug(
+    BOperandProbeState* probe_state,
+    int stage_idx,
+    int stage_byte_slot,
+    int source_byte_value,
+    SrcCoord const& src_coord,
+    DstCoord const& dst_coord) {
+  if (probe_state == nullptr) {
+    return;
+  }
+  int slot = probe_state->producer_debug_count;
+  if (slot < 0 || slot >= kProducerDebugEntryCount) {
+    return;
+  }
+  probe_state->producer_debug_count = slot + 1;
+  probe_state->producer_debug_stage[slot] = stage_idx;
+  probe_state->producer_debug_slot[slot] = stage_byte_slot;
+  probe_state->producer_debug_value[slot] = source_byte_value;
+  for (int idx = 0; idx < kProducerDebugComponentCount; ++idx) {
+    probe_state->producer_debug_src[slot][idx] = -1;
+    probe_state->producer_debug_dst[slot][idx] = -1;
+  }
+  int src_count = 0;
+  FlattenCoordComponents(
+      src_coord,
+      probe_state->producer_debug_src[slot],
+      kProducerDebugComponentCount,
+      src_count);
+  int dst_count = 0;
+  FlattenCoordComponents(
+      dst_coord,
+      probe_state->producer_debug_dst[slot],
+      kProducerDebugComponentCount,
+      dst_count);
+}
+
+template <class Value>
+CUTE_DEVICE int ProbeSourceValueLowByte(Value const& value) {
+  auto value_copy = value;
+  auto const* value_bytes =
+      reinterpret_cast<std::uint8_t const*>(&value_copy);
+  return static_cast<int>(value_bytes[0]);
+}
+
+template <class SrcCoord>
+CUTE_DEVICE int ProbeRawPackedByteValue(
+    void const* raw_packed_bytes,
+    int raw_row_bytes,
+    int source_row_base,
+    int source_k_span,
+    SrcCoord const& src_coord) {
+  if (raw_packed_bytes == nullptr || raw_row_bytes <= 0) {
+    return -1;
+  }
+  int const global_row = source_row_base + CoordGet0(src_coord);
+  int const global_byte =
+      CoordGet1(src_coord) + CoordGet2(src_coord) * source_k_span;
+  if (global_row < 0 || global_byte < 0 || global_byte >= raw_row_bytes) {
+    return -1;
+  }
+  auto const* raw_bytes =
+      reinterpret_cast<std::uint8_t const*>(raw_packed_bytes);
+  std::size_t const linear_index =
+      static_cast<std::size_t>(global_row) * static_cast<std::size_t>(raw_row_bytes) +
+      static_cast<std::size_t>(global_byte);
+  return static_cast<int>(raw_bytes[linear_index]);
+}
+
+CUTE_DEVICE void LoadSemanticWeightStageSlot(
+    BOperandProbeState const* probe_state,
+    int stage_idx,
+    int stage_byte_slot,
+    int packed_selector,
+    int& source_row,
+    int& source_byte_index,
+    int& source_k_tile) {
+  source_row = -1;
+  source_byte_index = -1;
+  source_k_tile = -1;
+  if (probe_state == nullptr ||
+      stage_idx < 0 ||
+      stage_idx >= kMaxSemanticStageCount ||
+      stage_byte_slot < 0 ||
+      stage_byte_slot >= kMaxSemanticStageByteSlots) {
+    return;
+  }
+  bool const use_alt =
+      packed_selector != 0 &&
+      probe_state->semantic_weight_rows_alt[stage_idx][stage_byte_slot] !=
+          static_cast<std::int16_t>(-1);
+  if (use_alt) {
+    source_row = static_cast<int>(probe_state->semantic_weight_rows_alt[stage_idx][stage_byte_slot]);
+    source_byte_index = static_cast<int>(probe_state->semantic_weight_byte_indices_alt[stage_idx][stage_byte_slot]);
+    source_k_tile = static_cast<int>(probe_state->semantic_weight_k_tiles_alt[stage_idx][stage_byte_slot]);
+    return;
+  }
+  source_row = static_cast<int>(probe_state->semantic_weight_rows[stage_idx][stage_byte_slot]);
+  source_byte_index = static_cast<int>(probe_state->semantic_weight_byte_indices[stage_idx][stage_byte_slot]);
+  source_k_tile = static_cast<int>(probe_state->semantic_weight_k_tiles[stage_idx][stage_byte_slot]);
+}
+
+template <class GmemTensor, class SrcCoordTensor, class DstCoordTensor, class Stage0Layout>
+CUTE_DEVICE void RecordSemanticWeightSourceStage(
+    BOperandProbeState* probe_state,
+    OperandKind operand_kind,
+    int write_stage,
+    GmemTensor const& g_values,
+    SrcCoordTensor const& src_coords,
+    DstCoordTensor const& dst_coords,
+    Stage0Layout const& stage0_layout,
+    int source_row_base,
+    int source_k_span,
+    void const* raw_packed_bytes = nullptr,
+    int raw_row_bytes = 0) {
+  if (!ProbeSemanticSourceEnabled(probe_state, operand_kind) ||
+      !ProbeCurrentBlockMatches(probe_state)) {
+    return;
+  }
+
+  ClearSemanticWeightStage(probe_state, write_stage);
+  ForEachProbeCoordPairIndexed(
+      src_coords,
+      dst_coords,
+      [&](auto const& src_coord, auto const& dst_coord, int /*physical*/) {
+    int const dst_row = CoordGet0(dst_coord);
+    int const dst_col = CoordGet2(dst_coord);
+    int const stage_byte_slot =
+        static_cast<int>(stage0_layout(dst_row, dst_col)) / 2;
+    int const source_packed_coord = CoordGet1(src_coord);
+    int const source_row_delta =
+        operand_kind == OperandKind::kActivation
+            ? ProbeSemanticActivationRowFromPackedCoord(source_packed_coord)
+            : ProbeSemanticWeightRowFromPackedCoord(source_packed_coord);
+    int const source_row = source_row_base + source_row_delta;
+    int const source_k_tile = CoordGet2(src_coord);
+    int const source_byte_index =
+        (source_packed_coord / 2) + source_k_tile * source_k_span;
+    StoreSemanticWeightStageSlot(
+        probe_state,
+        write_stage,
+        stage_byte_slot,
+        source_row,
+        source_byte_index,
+        source_k_tile);
+    int source_byte_value = ProbeSourceValueLowByte(g_values(src_coord));
+    int const raw_byte_value = ProbeRawPackedByteValue(
+        raw_packed_bytes,
+        raw_row_bytes,
+        source_row_base,
+        source_k_span,
+        src_coord);
+    if (raw_byte_value >= 0) {
+      source_byte_value = raw_byte_value;
+    }
+    RecordProducerSemanticDebug(
+        probe_state,
+        write_stage,
+        stage_byte_slot,
+        source_byte_value,
+        src_coord,
+        dst_coord);
+  });
+}
+
+template <class BlkCoord>
+CUTE_DEVICE void RecordCurrentCtaTileContext(
+    BOperandProbeState* probe_state,
+    BlkCoord const& blk_coord,
+    int work_k_tile_start,
+    int work_k_tile_count) {
+  if (probe_state == nullptr || probe_state->enabled == 0 || !ProbeCurrentBlockMatches(probe_state)) {
+    return;
+  }
+  int const slot = BlockContextSlot();
+  if (slot < 0) {
+    return;
+  }
+  auto& entry = probe_state->cta_contexts[slot];
+  entry.valid = 1;
+  entry.block_idx_x = static_cast<int>(blockIdx.x);
+  entry.block_idx_y = static_cast<int>(blockIdx.y);
+  entry.block_idx_z = static_cast<int>(blockIdx.z);
+  entry.tile_m_idx = CoordGet0(cute::get<0>(blk_coord));
+  entry.tile_n_idx = CoordGet0(cute::get<1>(blk_coord));
+  entry.tile_l_idx = CoordGet0(cute::get<3>(blk_coord));
+  entry.work_k_tile_start = work_k_tile_start;
+  entry.work_k_tile_count = work_k_tile_count;
+}
+
+template <class MainloopParams, class BlkCoord>
+CUTE_DEVICE void RecordCurrentCtaTileContextForParams(
+    MainloopParams const& mainloop_params,
+    BlkCoord const& blk_coord,
+    int work_k_tile_start,
+    int work_k_tile_count) {
+  RecordCurrentCtaTileContext(
+      ProbeStateResolver<MainloopParams>::get(mainloop_params),
+      blk_coord,
+      work_k_tile_start,
+      work_k_tile_count);
+}
+
+template <class CoordTensor, class BytePtr, class Stage0Layout>
+CUTE_DEVICE void MaybeOverwriteBOperandSource(
+    BOperandProbeState const* probe_state,
+    int thread_idx,
+    CoordTensor const& coord_tensor,
+    BytePtr smem_b_bytes,
+    Stage0Layout const& stage0_B) {
+  if (!ProbeSyntheticBOverwriteEnabled(probe_state) ||
+      !ProbeCurrentBlockMatches(probe_state) ||
+      (!(probe_state != nullptr && probe_state->overwrite_all_threads != 0) &&
+       !ProbeActiveForThread(probe_state, thread_idx))) {
+    return;
+  }
+
+  using CoordTensorT = typename std::remove_cv<typename std::remove_reference<CoordTensor>::type>::type;
+
+  if constexpr (CoordTensorT::rank == 1) {
+    for (int i = 0; i < size<0>(coord_tensor); ++i) {
+      auto const idx = make_coord(i);
+      auto const coord = coord_tensor(idx);
+      int const stage0_offset =
+          static_cast<int>(stage0_B(CoordGet0(coord), CoordGet1(coord)));
+      smem_b_bytes[stage0_offset / 2] = SyntheticBByteForStageOffset(probe_state, stage0_offset);
+    }
+  } else if constexpr (CoordTensorT::rank == 2) {
+    for (int i = 0; i < size<0>(coord_tensor); ++i) {
+      for (int j = 0; j < size<1>(coord_tensor); ++j) {
+        auto const idx = make_coord(i, j);
+        auto const coord = coord_tensor(idx);
+        int const stage0_offset =
+            static_cast<int>(stage0_B(CoordGet0(coord), CoordGet1(coord)));
+        smem_b_bytes[stage0_offset / 2] = SyntheticBByteForStageOffset(probe_state, stage0_offset);
+      }
+    }
+  } else if constexpr (CoordTensorT::rank == 3) {
+    for (int i = 0; i < size<0>(coord_tensor); ++i) {
+      for (int j = 0; j < size<1>(coord_tensor); ++j) {
+        for (int k = 0; k < size<2>(coord_tensor); ++k) {
+          auto const idx = make_coord(i, j, k);
+          auto const coord = coord_tensor(idx);
+          int const stage0_offset =
+              static_cast<int>(stage0_B(CoordGet0(coord), CoordGet1(coord)));
+          smem_b_bytes[stage0_offset / 2] = SyntheticBByteForStageOffset(probe_state, stage0_offset);
+        }
+      }
+    }
+  } else if constexpr (CoordTensorT::rank == 4) {
+    for (int i = 0; i < size<0>(coord_tensor); ++i) {
+      for (int j = 0; j < size<1>(coord_tensor); ++j) {
+        for (int k = 0; k < size<2>(coord_tensor); ++k) {
+          for (int l = 0; l < size<3>(coord_tensor); ++l) {
+            auto const idx = make_coord(i, j, k, l);
+            auto const coord = coord_tensor(idx);
+            int const stage0_offset =
+                static_cast<int>(stage0_B(CoordGet0(coord), CoordGet1(coord)));
+            smem_b_bytes[stage0_offset / 2] = SyntheticBByteForStageOffset(probe_state, stage0_offset);
+          }
+        }
+      }
+    }
+  } else {
+    static_assert(
+        CoordTensorT::rank <= 4,
+        "MaybeOverwriteBOperandSource only supports rank <= 4");
+  }
+}
+
+template <class CoordTensor, class BytePtr, class Stage0Layout>
+CUTE_DEVICE void MaybeOverwriteBOperandSource(
+    int thread_idx,
+    CoordTensor const& coord_tensor,
+    BytePtr smem_b_bytes,
+    Stage0Layout const& stage0_B) {
+  MaybeOverwriteBOperandSource(&g_b_operand_probe, thread_idx, coord_tensor, smem_b_bytes, stage0_B);
+}
+
+CUTE_HOST_DEVICE constexpr int EntryIndex(int tid_slot, int n_tile, int k_block) {
+  return tid_slot * (kMaxNTiles * kMaxKBlocks) + n_tile * kMaxKBlocks + k_block;
+}
+
+template <class CoordTensor, class F>
+CUTE_HOST_DEVICE void ForEachProbeCoord(CoordTensor const& coord_tensor, F&& f) {
+  using CoordTensorT =
+      typename std::remove_cv<typename std::remove_reference<CoordTensor>::type>::type;
+  if constexpr (CoordTensorT::rank == 1) {
+    for (int i = 0; i < size<0>(coord_tensor); ++i) {
+      f(coord_tensor(make_coord(i)), i);
+    }
+  } else if constexpr (CoordTensorT::rank == 2) {
+    int physical = 0;
+    for (int i = 0; i < size<0>(coord_tensor); ++i) {
+      for (int j = 0; j < size<1>(coord_tensor); ++j) {
+        f(coord_tensor(make_coord(i, j)), physical++);
+      }
+    }
+  } else if constexpr (CoordTensorT::rank == 3) {
+    int physical = 0;
+    for (int i = 0; i < size<0>(coord_tensor); ++i) {
+      for (int j = 0; j < size<1>(coord_tensor); ++j) {
+        for (int k = 0; k < size<2>(coord_tensor); ++k) {
+          f(coord_tensor(make_coord(i, j, k)), physical++);
+        }
+      }
+    }
+  } else if constexpr (CoordTensorT::rank == 4) {
+    int physical = 0;
+    for (int i = 0; i < size<0>(coord_tensor); ++i) {
+      for (int j = 0; j < size<1>(coord_tensor); ++j) {
+        for (int k = 0; k < size<2>(coord_tensor); ++k) {
+          for (int l = 0; l < size<3>(coord_tensor); ++l) {
+            f(coord_tensor(make_coord(i, j, k, l)), physical++);
+          }
+        }
+      }
+    }
+  } else {
+    static_assert(CoordTensorT::rank <= 4, "ForEachProbeCoord only supports rank <= 4");
+  }
+}
+
+template <class BytePtr>
+CUTE_DEVICE void CaptureStageByteSnapshot(
+    BOperandProbeState* probe_state,
+    int thread_idx,
+    int read_stage,
+    BytePtr smem_bytes) {
+  if (probe_state == nullptr || !ProbeActiveForThread(probe_state, thread_idx)) {
+    return;
+  }
+  int const lead_tracked_tid =
+      probe_state->tracked_tid_count > 0 ? probe_state->tracked_tids[0] : -1;
+  if (thread_idx != lead_tracked_tid) {
+    return;
+  }
+  if (atomicCAS(&probe_state->stage_byte_snapshot_valid, 0, 1) != 0) {
+    return;
+  }
+  probe_state->stage_byte_snapshot_read_stage = read_stage;
+  auto volatile* smem_storage =
+      reinterpret_cast<volatile std::uint8_t*>(cute::raw_pointer_cast(smem_bytes));
+  constexpr int snapshot_slots[kStageByteSnapshotCount] = {
+      0, 1, 2, 3, 4, 5, 6, 7,
+      256, 257, 258, 259, 260, 261, 262, 263,
+  };
+  for (int idx = 0; idx < kStageByteSnapshotCount; ++idx) {
+    probe_state->stage_byte_snapshot_values[idx] =
+        static_cast<int>(smem_storage[snapshot_slots[idx]]);
+  }
+}
+
+template <class KBlock, class TCsCoords, class TCsSFCoords, class PartC, class Stage0Layout, class BytePtr, class TCr, class TCrCopyView, class TCrSF, class TCrSFCopyView>
+CUTE_DEVICE void RecordOperandPreImpl(
+    BOperandProbeState* probe_state,
+    int thread_idx,
+    int read_stage,
+    KBlock k_block,
+    TCsCoords const& tCs_coords,
+    TCsSFCoords const& tCsSF,
+    PartC const& part_c,
+    Stage0Layout const& stage0_layout,
+    BytePtr smem_bytes,
+    TCr const& tCr,
+    TCrCopyView const& tCr_copy_view,
+    TCrSF const& tCrSF,
+    TCrSFCopyView const& tCrSF_copy_view,
+    int sf_vec_size,
+    int smem_layout_atom_sfb_dim0,
+    int smem_layout_atom_sfb_dim1,
+    int sfb_stage_elems,
+    int sfb_total_elems,
+    int sfb_stage_shape_dim0,
+    int sfb_stage_shape_dim1,
+    int layout_sfb_tv_dim0,
+    int layout_sfb_tv_dim1) {
+  if (!ProbeActiveForThread(probe_state, thread_idx)) {
+    return;
+  }
+
+  int const n_tiles = static_cast<int>(size<2>(part_c));
+  bool const capture_any_thread = probe_state->capture_any_thread != 0;
+  int const tid_slot = ProbeThreadSlot(probe_state, thread_idx);
+  for (int n_tile = 0; n_tile < n_tiles && n_tile < kMaxNTiles; ++n_tile) {
+    auto c_atom_coords = part_c(_, 0, n_tile);
+    auto coord0 = c_atom_coords(0);
+
+    auto row_anchor = tCs_coords(_, n_tile, k_block, read_stage);
+    auto copy_coord0 = row_anchor(0);
+    auto copy_coord1 = row_anchor(1);
+
+    auto words = cute::recast<std::uint32_t>(tCr(_, n_tile, k_block));
+    int entry_index = 0;
+    if (capture_any_thread) {
+      entry_index = atomicAdd(&probe_state->next_slot, 1);
+      if (entry_index >= kEntryCount) {
+        return;
+      }
+    } else {
+      if (tid_slot < 0) {
+        return;
+      }
+      entry_index = EntryIndex(tid_slot, n_tile, int(k_block));
+    }
+    BOperandProbeEntry& entry = probe_state->entries[entry_index];
+    entry.valid = 1;
+    entry.thread_idx = thread_idx;
+    entry.block_idx_x = static_cast<int>(blockIdx.x);
+    entry.block_idx_y = static_cast<int>(blockIdx.y);
+    entry.block_idx_z = static_cast<int>(blockIdx.z);
+    entry.tile_m_idx = -1;
+    entry.tile_n_idx = -1;
+    entry.tile_l_idx = -1;
+    entry.work_k_tile_start = -1;
+    entry.work_k_tile_count = -1;
+    if (auto const* cta_context = LoadCurrentCtaTileContext(probe_state)) {
+      entry.tile_m_idx = cta_context->tile_m_idx;
+      entry.tile_n_idx = cta_context->tile_n_idx;
+      entry.tile_l_idx = cta_context->tile_l_idx;
+      entry.work_k_tile_start = cta_context->work_k_tile_start;
+      entry.work_k_tile_count = cta_context->work_k_tile_count;
+    }
+    entry.read_stage = read_stage;
+    entry.n_tile = n_tile;
+    entry.k_block = int(k_block);
+    entry.dispatch_stages = probe_state->dispatch_stages;
+    entry.dispatch_scheduler_stages = probe_state->dispatch_scheduler_stages;
+    entry.tcrb_k_blocks = static_cast<int>(size<2>(tCr));
+    entry.tcrb_copy_view_k_blocks = static_cast<int>(size<2>(tCr_copy_view));
+    entry.tcsb_coord_k_blocks = static_cast<int>(size<2>(tCs_coords));
+    entry.tcrsfb_k_blocks = static_cast<int>(size<2>(tCrSF));
+    entry.tcrsfb_copy_view_k_blocks = static_cast<int>(size<2>(tCrSF_copy_view));
+    entry.tcssfb_coord_k_blocks = static_cast<int>(size<2>(tCsSF));
+    entry.tcrb_dim0 = static_cast<int>(size<0>(tCr));
+    entry.tcrb_dim1 = static_cast<int>(size<1>(tCr));
+    entry.tcrb_copy_view_dim0 = static_cast<int>(size<0>(tCr_copy_view));
+    entry.tcrb_copy_view_dim1 = static_cast<int>(size<1>(tCr_copy_view));
+    entry.tcsb_coord_dim0 = static_cast<int>(size<0>(tCs_coords));
+    entry.tcsb_coord_dim1 = static_cast<int>(size<1>(tCs_coords));
+    entry.tcsb_coord_stage_count = static_cast<int>(size<3>(tCs_coords));
+    entry.tcrsfb_dim0 = static_cast<int>(size<0>(tCrSF));
+    entry.tcrsfb_dim1 = static_cast<int>(size<1>(tCrSF));
+    entry.tcrsfb_copy_view_dim0 = static_cast<int>(size<0>(tCrSF_copy_view));
+    entry.tcrsfb_copy_view_dim1 = static_cast<int>(size<1>(tCrSF_copy_view));
+    entry.tcssfb_coord_dim0 = static_cast<int>(size<0>(tCsSF));
+    entry.tcssfb_coord_dim1 = static_cast<int>(size<1>(tCsSF));
+    entry.tcssfb_coord_stage_count = static_cast<int>(size<3>(tCsSF));
+    entry.sf_vec_size = sf_vec_size;
+    entry.smem_layout_atom_sfb_dim0 = smem_layout_atom_sfb_dim0;
+    entry.smem_layout_atom_sfb_dim1 = smem_layout_atom_sfb_dim1;
+    entry.sfb_stage_elems = sfb_stage_elems;
+    entry.sfb_total_elems = sfb_total_elems;
+    entry.sfb_stage_shape_dim0 = sfb_stage_shape_dim0;
+    entry.sfb_stage_shape_dim1 = sfb_stage_shape_dim1;
+    entry.layout_sfb_tv_dim0 = layout_sfb_tv_dim0;
+    entry.layout_sfb_tv_dim1 = layout_sfb_tv_dim1;
+    entry.part_c_row0 = CoordGet0(coord0);
+    entry.part_c_col0 = CoordGet1(coord0);
+    entry.local_row0 = CoordGet0(copy_coord0);
+    entry.local_col0 = CoordGet1(copy_coord0);
+    entry.local_row1 = CoordGet0(copy_coord1);
+    entry.local_col1 = CoordGet1(copy_coord1);
+    entry.stage0_offset0 = static_cast<int>(stage0_layout(entry.local_row0, entry.local_col0));
+    entry.stage0_offset1 = static_cast<int>(stage0_layout(entry.local_row1, entry.local_col1));
+    if (n_tile == 0 && int(k_block) == 0) {
+      CaptureStageByteSnapshot(probe_state, thread_idx, read_stage, smem_bytes);
+    }
+    entry.copy_view_sig_count = 0;
+    for (int sig = 0; sig < kCopyViewSignatureLen; ++sig) {
+      entry.copy_view_stage_offsets[sig] = -1;
+      entry.copy_view_stage_bytes[sig] = -1;
+    }
+    entry.copy_view_raw_sig_count = 0;
+    for (int sig = 0; sig < kCopyViewRawSignatureLen; ++sig) {
+      entry.copy_view_raw_rows[sig] = -1;
+      entry.copy_view_raw_cols[sig] = -1;
+      entry.copy_view_raw_stage_offsets[sig] = -1;
+      entry.copy_view_raw_stage_bytes[sig] = -1;
+      entry.copy_view_raw_byte_indices[sig] = -1;
+      for (int comp = 0; comp < kProducerDebugComponentCount; ++comp) {
+        entry.copy_view_raw_coord_components[sig][comp] = -1;
+      }
+      entry.copy_view_raw_semantic_rows[sig] = -1;
+      entry.copy_view_raw_semantic_byte_indices[sig] = -1;
+      entry.copy_view_raw_semantic_k_tiles[sig] = -1;
+    }
+    entry.semantic_row0 = -1;
+    entry.semantic_byte0 = -1;
+    entry.semantic_k_tile0 = -1;
+    entry.semantic_row1 = -1;
+    entry.semantic_byte1 = -1;
+    entry.semantic_k_tile1 = -1;
+    for (int sig = 0; sig < kCopyViewSignatureLen; ++sig) {
+      entry.copy_view_semantic_rows[sig] = -1;
+      entry.copy_view_semantic_byte_indices[sig] = -1;
+      entry.copy_view_semantic_k_tiles[sig] = -1;
+    }
+    entry.sf_reg_word_count = 0;
+    for (int word = 0; word < 4; ++word) {
+      entry.sf_reg_words_pre[word] = 0u;
+      entry.sf_reg_words_post[word] = 0u;
+    }
+    auto volatile* smem_storage =
+        reinterpret_cast<volatile std::uint8_t*>(cute::raw_pointer_cast(smem_bytes));
+    auto sf_words = cute::recast<std::uint32_t>(cute::filter_zeros(tCrSF(_, n_tile, k_block)));
+    LoadSemanticWeightStageSlot(
+        probe_state,
+        read_stage,
+        entry.stage0_offset0 / 2,
+        entry.stage0_offset0 & 0x1,
+        entry.semantic_row0,
+        entry.semantic_byte0,
+        entry.semantic_k_tile0);
+    LoadSemanticWeightStageSlot(
+        probe_state,
+        read_stage,
+        entry.stage0_offset1 / 2,
+        entry.stage0_offset1 & 0x1,
+        entry.semantic_row1,
+        entry.semantic_byte1,
+        entry.semantic_k_tile1);
+    ForEachProbeCoord(row_anchor, [&](auto const& coord, int physical) {
+      int const row = CoordGet0(coord);
+      int const col = CoordGet1(coord);
+      int const stage0_offset =
+          static_cast<int>(stage0_layout(row, col));
+      int const stage_byte = static_cast<int>(smem_storage[stage0_offset / 2]);
+      int semantic_row = -1;
+      int semantic_byte_index = -1;
+      int semantic_k_tile = -1;
+      LoadSemanticWeightStageSlot(
+          probe_state,
+          read_stage,
+          stage0_offset / 2,
+          stage0_offset & 0x1,
+          semantic_row,
+          semantic_byte_index,
+          semantic_k_tile);
+      if (physical < kCopyViewSignatureLen) {
+        entry.copy_view_sig_count = physical + 1;
+        entry.copy_view_stage_offsets[physical] = stage0_offset;
+        entry.copy_view_stage_bytes[physical] = stage_byte;
+        entry.copy_view_semantic_rows[physical] = semantic_row;
+        entry.copy_view_semantic_byte_indices[physical] = semantic_byte_index;
+        entry.copy_view_semantic_k_tiles[physical] = semantic_k_tile;
+      }
+      if (physical < kCopyViewRawSignatureLen) {
+        entry.copy_view_raw_sig_count = physical + 1;
+        entry.copy_view_raw_rows[physical] = row;
+        entry.copy_view_raw_cols[physical] = col;
+        entry.copy_view_raw_stage_offsets[physical] = stage0_offset;
+        entry.copy_view_raw_stage_bytes[physical] = stage_byte;
+        entry.copy_view_raw_byte_indices[physical] = col / 2;
+        int coord_component_count = 0;
+        FlattenCoordComponents(
+            coord,
+            entry.copy_view_raw_coord_components[physical],
+            kProducerDebugComponentCount,
+            coord_component_count);
+        entry.copy_view_raw_semantic_rows[physical] = semantic_row;
+        entry.copy_view_raw_semantic_byte_indices[physical] = semantic_byte_index;
+        entry.copy_view_raw_semantic_k_tiles[physical] = semantic_k_tile;
+      }
+    });
+    entry.sf_reg_word_count = static_cast<int>(size(sf_words));
+    if (entry.sf_reg_word_count > 0) {
+      entry.sf_reg_words_pre[0] = static_cast<std::uint32_t>(sf_words(0));
+    }
+    if (entry.sf_reg_word_count > 1) {
+      entry.sf_reg_words_pre[1] = static_cast<std::uint32_t>(sf_words(1));
+    }
+    if (entry.sf_reg_word_count > 2) {
+      entry.sf_reg_words_pre[2] = static_cast<std::uint32_t>(sf_words(2));
+    }
+    if (entry.sf_reg_word_count > 3) {
+      entry.sf_reg_words_pre[3] = static_cast<std::uint32_t>(sf_words(3));
+    }
+    entry.reg0_pre = static_cast<std::uint32_t>(words(0));
+    entry.reg1_pre = static_cast<std::uint32_t>(words(1));
+  }
+}
+
+template <class KBlock, class PartC, class TCr>
+CUTE_DEVICE void RecordOperandPostImpl(
+    BOperandProbeState* probe_state,
+    int thread_idx,
+    KBlock k_block,
+    PartC const& part_c,
+    TCr const& tCr) {
+  if (probe_state == nullptr || probe_state->capture_any_thread != 0) {
+    return;
+  }
+  int const tid_slot = ProbeThreadSlot(probe_state, thread_idx);
+  if (tid_slot < 0 || !ProbeActiveForThread(probe_state, thread_idx)) {
+    return;
+  }
+
+  int const n_tiles = static_cast<int>(size<2>(part_c));
+  for (int n_tile = 0; n_tile < n_tiles && n_tile < kMaxNTiles; ++n_tile) {
+    auto words = cute::recast<std::uint32_t>(tCr(_, n_tile, k_block));
+    BOperandProbeEntry& entry = probe_state->entries[EntryIndex(tid_slot, n_tile, int(k_block))];
+    entry.reg0_post = static_cast<std::uint32_t>(words(0));
+    entry.reg1_post = static_cast<std::uint32_t>(words(1));
+  }
+}
+
+template <class KBlock, class PartC, class TCrSF>
+CUTE_DEVICE void RecordOperandScalePostImpl(
+    BOperandProbeState* probe_state,
+    int thread_idx,
+    KBlock k_block,
+    PartC const& part_c,
+    TCrSF const& tCrSF) {
+  if (probe_state == nullptr || probe_state->capture_any_thread != 0) {
+    return;
+  }
+  int const tid_slot = ProbeThreadSlot(probe_state, thread_idx);
+  if (tid_slot < 0 || !ProbeActiveForThread(probe_state, thread_idx)) {
+    return;
+  }
+
+  int const n_tiles = static_cast<int>(size<2>(part_c));
+  for (int n_tile = 0; n_tile < n_tiles && n_tile < kMaxNTiles; ++n_tile) {
+    auto sf_words = cute::recast<std::uint32_t>(cute::filter_zeros(tCrSF(_, n_tile, k_block)));
+    BOperandProbeEntry& entry = probe_state->entries[EntryIndex(tid_slot, n_tile, int(k_block))];
+    int const word_count = static_cast<int>(size(sf_words));
+    if (entry.sf_reg_word_count < word_count) {
+      entry.sf_reg_word_count = word_count;
+    }
+    if (word_count > 0) {
+      entry.sf_reg_words_post[0] = static_cast<std::uint32_t>(sf_words(0));
+    }
+    if (word_count > 1) {
+      entry.sf_reg_words_post[1] = static_cast<std::uint32_t>(sf_words(1));
+    }
+    if (word_count > 2) {
+      entry.sf_reg_words_post[2] = static_cast<std::uint32_t>(sf_words(2));
+    }
+    if (word_count > 3) {
+      entry.sf_reg_words_post[3] = static_cast<std::uint32_t>(sf_words(3));
+    }
+  }
+}
