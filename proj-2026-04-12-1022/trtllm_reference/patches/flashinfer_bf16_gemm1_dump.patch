+            "%s(%d,%d):%d:%d:%d",
+            sig == 0 ? "" : ",",
+            entry.copy_view_raw_rows[sig],
+            entry.copy_view_raw_cols[sig],
+            entry.copy_view_raw_stage_offsets[sig],
+            entry.copy_view_raw_stage_bytes[sig],
+            entry.copy_view_raw_byte_indices[sig]);
+      }
+      std::fprintf(probe_fp, "\n");
+      std::fprintf(probe_fp, "raw_copy_view_components=");
+      for (int sig = 0; sig < safe_raw_sig_count; ++sig) {
+        std::fprintf(
+            probe_fp,
+            "%s(",
+            sig == 0 ? "" : ",");
+        for (int comp = 0;
+             comp < cutlass::gemm::collective::nemotron_probe::kProducerDebugComponentCount;
+             ++comp) {
+          std::fprintf(
+              probe_fp,
+              "%s%d",
+              comp == 0 ? "" : ",",
+              entry.copy_view_raw_coord_components[sig][comp]);
+        }
+        std::fprintf(probe_fp, ")");
+      }
+      std::fprintf(probe_fp, "\n");
+    }
+    bool show_semantic =
+        entry.semantic_row0 >= 0 ||
+        entry.semantic_byte0 >= 0 ||
+        entry.semantic_k_tile0 >= 0 ||
+        entry.semantic_row1 >= 0 ||
+        entry.semantic_byte1 >= 0 ||
+        entry.semantic_k_tile1 >= 0;
+    if (!show_semantic) {
+      for (int sig = 0; sig < safe_sig_count; ++sig) {
+        if (entry.copy_view_semantic_rows[sig] >= 0 ||
+            entry.copy_view_semantic_byte_indices[sig] >= 0 ||
+            entry.copy_view_semantic_k_tiles[sig] >= 0) {
+          show_semantic = true;
+          break;
+        }
+      }
+    }
+    if (!show_semantic) {
+      for (int sig = 0; sig < safe_raw_sig_count; ++sig) {
+        if (entry.copy_view_raw_semantic_rows[sig] >= 0 ||
+            entry.copy_view_raw_semantic_byte_indices[sig] >= 0 ||
+            entry.copy_view_raw_semantic_k_tiles[sig] >= 0) {
+          show_semantic = true;
+          break;
+        }
+      }
+    }
+    if (show_semantic) {
+      std::fprintf(
+          probe_fp,
+          "semantic_copy_view=logical0=(%d,%d,%d) logical1=(%d,%d,%d) sig=",
+          entry.semantic_row0,
+          entry.semantic_byte0,
+          entry.semantic_k_tile0,
+          entry.semantic_row1,
+          entry.semantic_byte1,
+          entry.semantic_k_tile1);
+      for (int sig = 0; sig < safe_sig_count; ++sig) {
+        std::fprintf(
+            probe_fp,
+            "%s%d:%d:%d",
+            sig == 0 ? "" : ",",
+            entry.copy_view_semantic_rows[sig],
+            entry.copy_view_semantic_byte_indices[sig],
+            entry.copy_view_semantic_k_tiles[sig]);
+      }
+      std::fprintf(probe_fp, "\n");
+      if (safe_raw_sig_count > 0) {
+        std::fprintf(probe_fp, "semantic_raw_copy_view=");
+        for (int sig = 0; sig < safe_raw_sig_count; ++sig) {
+          std::fprintf(
+              probe_fp,
+              "%s(%d,%d):%d:%d:%d",
+              sig == 0 ? "" : ",",
+              entry.copy_view_raw_rows[sig],
+              entry.copy_view_raw_cols[sig],
+              entry.copy_view_raw_semantic_rows[sig],
+              entry.copy_view_raw_semantic_byte_indices[sig],
+              entry.copy_view_raw_semantic_k_tiles[sig]);
+        }
+        std::fprintf(probe_fp, "\n");
+      }
+    }
+  }
+
+  std::fclose(probe_fp);
+  std::fprintf(stderr, "[NEMOTRON] wrote operand probe to %s\n", probe_path);
+}
