+inline void loadNemotronBOperandProbeOperandKind(NemotronBOperandProbeState& probe) {
+  probe.operand_kind = int(cutlass::gemm::collective::nemotron_probe::OperandKind::kWeight);
+  char const* operand_env = std::getenv("NEMOTRON_TRTLLM_OPERAND_PROBE_OPERAND");
+  if (operand_env == nullptr || operand_env[0] == '\0') {
+    return;
+  }
+  if (std::strcmp(operand_env, "activation") == 0 ||
+      std::strcmp(operand_env, "input") == 0 ||
+      std::strcmp(operand_env, "a") == 0) {
+    probe.operand_kind = int(cutlass::gemm::collective::nemotron_probe::OperandKind::kActivation);
+  }
+}
+
+inline void configureNemotronBOperandProbePhysicalMapping(
+    NemotronBOperandProbeState& probe,
+    bool swap_ab) {
+  using OperandKind = cutlass::gemm::collective::nemotron_probe::OperandKind;
+  probe.swap_ab = swap_ab ? 1 : 0;
+  probe.physical_a_operand_kind =
+      swap_ab ? int(OperandKind::kWeight) : int(OperandKind::kActivation);
+  probe.physical_b_operand_kind =
+      swap_ab ? int(OperandKind::kActivation) : int(OperandKind::kWeight);
+}
+
+inline void loadNemotronBOperandProbeTrackedTids(NemotronBOperandProbeState& probe) {
+  probe.tracked_tid_count = cutlass::gemm::collective::nemotron_probe::kDefaultTrackedTidCount;
+  for (int idx = 0; idx < cutlass::gemm::collective::nemotron_probe::kMaxTrackedTidCount; ++idx) {
+    probe.tracked_tids[idx] = -1;
+  }
+  for (int idx = 0; idx < cutlass::gemm::collective::nemotron_probe::kDefaultTrackedTidCount; ++idx) {
+    probe.tracked_tids[idx] = cutlass::gemm::collective::nemotron_probe::kDefaultTrackedTids[idx];
+  }
+
+  char const* tracked_tids_env = std::getenv("NEMOTRON_TRTLLM_OPERAND_PROBE_TIDS");
+  if (tracked_tids_env == nullptr || tracked_tids_env[0] == '\0') {
+    return;
+  }
+
+  int parsed_count = 0;
+  char const* cursor = tracked_tids_env;
+  while (*cursor != '\0' &&
+         parsed_count < cutlass::gemm::collective::nemotron_probe::kMaxTrackedTidCount) {
+    while (*cursor == ' ' || *cursor == '\t' || *cursor == ',') {
+      ++cursor;
+    }
+    if (*cursor == '\0') {
+      break;
+    }
+    char* end_ptr = nullptr;
+    long const parsed_tid = std::strtol(cursor, &end_ptr, 10);
+    if (end_ptr == cursor) {
+      break;
+    }
+    probe.tracked_tids[parsed_count++] = static_cast<int>(parsed_tid);
+    cursor = end_ptr;
+  }
+  if (parsed_count > 0) {
+    probe.tracked_tid_count = parsed_count;
+  }
+}
+
+inline int loadNemotronEnvIntOrDefault(char const* env_name, int default_value) {
+  char const* env_value = std::getenv(env_name);
+  if (env_value == nullptr || env_value[0] == '\0') {
+    return default_value;
+  }
+  char* end_ptr = nullptr;
+  long const parsed = std::strtol(env_value, &end_ptr, 10);
+  if (end_ptr == env_value) {
+    return default_value;
+  }
+  return static_cast<int>(parsed);
+}
