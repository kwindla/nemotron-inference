+CUTE_DEVICE bool ProbeCurrentBlockMatches(BOperandProbeState const* probe_state) {
+  if (probe_state == nullptr) {
+    return false;
+  }
+  if (probe_state->filter_block_idx_x >= 0 &&
+      probe_state->filter_block_idx_x != static_cast<int>(blockIdx.x)) {
+    return false;
+  }
+  if (probe_state->filter_block_idx_y >= 0 &&
+      probe_state->filter_block_idx_y != static_cast<int>(blockIdx.y)) {
+    return false;
+  }
+  if (probe_state->filter_block_idx_z >= 0 &&
+      probe_state->filter_block_idx_z != static_cast<int>(blockIdx.z)) {
+    return false;
+  }
+  return true;
+}
