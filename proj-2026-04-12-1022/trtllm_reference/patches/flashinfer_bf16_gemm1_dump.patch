+CUTE_HOST_DEVICE constexpr std::uint8_t SyntheticBByteForStageOffset(
+    BOperandProbeState const* probe_state,
+    int stage0_offset) {
+  if (probe_state == nullptr) {
+    return 0u;
+  }
+  int const stage_slot = stage0_offset / 2;
+  if (probe_state->synthetic_b_mode == int(SyntheticBMode::kStageSlotLowByte)) {
+    return static_cast<std::uint8_t>(stage_slot & 0xff);
+  }
+  if (probe_state->synthetic_b_mode == int(SyntheticBMode::kStageSlotBit)) {
+    int const bit = probe_state->synthetic_b_arg;
+    return static_cast<std::uint8_t>((stage_slot >> bit) & 0x1);
+  }
+  return 0u;
+}
