+CUTE_DEVICE int BlockContextSlot() {
+  int const slot =
+      static_cast<int>(blockIdx.x) +
+      static_cast<int>(gridDim.x) *
+          (static_cast<int>(blockIdx.y) +
+           static_cast<int>(gridDim.y) * static_cast<int>(blockIdx.z));
+  if (slot < 0 || slot >= kMaxCtaContextSlots) {
+    return -1;
+  }
+  return slot;
+}
