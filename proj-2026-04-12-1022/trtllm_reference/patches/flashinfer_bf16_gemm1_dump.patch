+template <class Coord>
+CUTE_HOST_DEVICE constexpr void FlattenCoordPair(Coord const& coord, int& row, int& col, int& count) {
+  if (count >= 2) {
+    return;
+  }
+  if constexpr (cute::is_tuple<Coord>::value) {
+    constexpr std::size_t kTupleSize = std::tuple_size_v<std::remove_cv_t<std::remove_reference_t<Coord>>>;
+    FlattenCoordPair(cute::get<0>(coord), row, col, count);
+    if constexpr (kTupleSize > 1) {
+      if (count < 2) {
+        FlattenCoordPair(cute::get<1>(coord), row, col, count);
+      }
+    }
+    if constexpr (kTupleSize > 2) {
+      if (count < 2) {
+        FlattenCoordPair(cute::get<2>(coord), row, col, count);
+      }
+    }
+  } else {
+    if (count == 0) {
+      row = static_cast<int>(coord);
+    } else {
+      col = static_cast<int>(coord);
+    }
+    ++count;
+  }
+}
+
+template <class Coord>
+CUTE_HOST_DEVICE constexpr void FlattenCoordTriple(
+    Coord const& coord,
+    int& row,
+    int& col,
+    int& depth,
+    int& count) {
+  if (count >= 3) {
+    return;
+  }
+  if constexpr (cute::is_tuple<Coord>::value) {
+    constexpr std::size_t kTupleSize = std::tuple_size_v<std::remove_cv_t<std::remove_reference_t<Coord>>>;
+    FlattenCoordTriple(cute::get<0>(coord), row, col, depth, count);
+    if constexpr (kTupleSize > 1) {
+      if (count < 3) {
+        FlattenCoordTriple(cute::get<1>(coord), row, col, depth, count);
+      }
+    }
+    if constexpr (kTupleSize > 2) {
+      if (count < 3) {
+        FlattenCoordTriple(cute::get<2>(coord), row, col, depth, count);
+      }
+    }
+  } else {
+    if (count == 0) {
+      row = static_cast<int>(coord);
+    } else if (count == 1) {
+      col = static_cast<int>(coord);
+    } else {
+      depth = static_cast<int>(coord);
+    }
+    ++count;
+  }
+}
+
+template <class Coord>
+CUTE_HOST_DEVICE constexpr void FlattenCoordComponents(
+    Coord const& coord,
+    int* values,
+    int max_count,
+    int& count) {
+  if (count >= max_count) {
+    return;
+  }
+  if constexpr (cute::is_tuple<Coord>::value) {
+    constexpr std::size_t kTupleSize = std::tuple_size_v<std::remove_cv_t<std::remove_reference_t<Coord>>>;
+    FlattenCoordComponents(cute::get<0>(coord), values, max_count, count);
+    if constexpr (kTupleSize > 1) {
+      if (count < max_count) {
+        FlattenCoordComponents(cute::get<1>(coord), values, max_count, count);
+      }
+    }
+    if constexpr (kTupleSize > 2) {
+      if (count < max_count) {
+        FlattenCoordComponents(cute::get<2>(coord), values, max_count, count);
+      }
+    }
+  } else {
+    values[count++] = static_cast<int>(coord);
+  }
+}
