+CUTE_HOST_DEVICE constexpr int ClampSemanticCoordComponent(int value) {
+  return value >= -32767 && value <= 32767 ? value : -1;
+}
+
+CUTE_HOST_DEVICE constexpr int ProbeSemanticWeightRowFromPackedCoord(int packed_coord) {
+  return ((packed_coord & ~0x7) << 2) +
+         ((packed_coord & 0x4) << 1) +
+         ((packed_coord & 0x1) << 2);
+}
+
+CUTE_HOST_DEVICE constexpr int ProbeSemanticActivationRowFromPackedCoord(int packed_coord) {
+  return ((packed_coord & ~0x1) << 3) +
+         ((packed_coord & 0x1) << 2);
+}
