+CUTE_DEVICE int ProbeThreadSlot(BOperandProbeState const* probe_state, int tid) {
+  if (probe_state == nullptr) {
+    return -1;
+  }
+  int const tracked_count = probe_state->tracked_tid_count;
+  for (int idx = 0; idx < tracked_count && idx < kMaxTrackedTidCount; ++idx) {
+    if (probe_state->tracked_tids[idx] == tid) {
+      return idx;
+    }
+  }
+  return -1;
+}
